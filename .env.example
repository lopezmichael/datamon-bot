# ==========================================
# Datamon Bot — Environment Variables
# ==========================================
# Copy this file to .env and fill in all values.
# All Discord IDs are numeric snowflakes (right-click → Copy ID with Developer Mode on).

# ------------------------------------------
# Discord Bot
# ------------------------------------------
# Bot token from Discord Developer Portal → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Server (guild) ID — right-click server name → Copy Server ID
DISCORD_GUILD_ID=

# ------------------------------------------
# Discord Role IDs
# ------------------------------------------
# Right-click each role in Server Settings → Roles → Copy Role ID
DISCORD_ROLE_PLATFORM_ADMIN=
DISCORD_ROLE_REGIONAL_ADMIN=
DISCORD_ROLE_SCENE_ADMIN=

# ------------------------------------------
# Discord Channel IDs
# ------------------------------------------
# Right-click channel → Copy Channel ID
DISCORD_CHANNEL_SCENE_REQUESTS=
DISCORD_CHANNEL_BUG_REPORTS=
DISCORD_CHANNEL_FEATURE_REQUESTS=

# ------------------------------------------
# Discord Forum Tag IDs
# ------------------------------------------
# Tags the bot ADDS to threads. Use the API to get tag IDs (see README).
# Any other tag already on a thread is preserved automatically at runtime.
# Every ID here is checked against the forum's real tags at startup — a wrong or
# deleted one is logged and posted to #bot-log instead of failing silently.
#
# #scene-requests — added when scene request completed via reaction
DISCORD_TAG_ONBOARDED=
# #bug-reports — added when bug fixed via reaction
DISCORD_TAG_FIXED=
# #feature-requests — added when feature shipped via reaction
DISCORD_TAG_SHIPPED=

# Initial/status tags the bot REMOVES when resolving a thread
# #bug-reports — status tags removed when marked as Fixed
DISCORD_TAG_NEW_BUG_REPORTS=
DISCORD_TAG_UNDER_REVIEW_BUG_REPORTS=
DISCORD_TAG_CONFIRMED_BUG_REPORTS=
# #bug-reports — "Won't Fix" completion tag (archived after 1 week).
# Doubles as the channel's reject tag: a bug rejected in the app is healed to
# this instead of "Fixed". No other channel has one — see config.FORUM_CHANNELS.
DISCORD_TAG_WONT_FIX=

# #scene-requests — status tags removed when marked as Onboarded
DISCORD_TAG_NEW_SCENE_REQUESTS=
DISCORD_TAG_NEEDS_MORE_INFO_SCENE_REQUESTS=
DISCORD_TAG_NEEDS_ADMIN_SCENE_REQUESTS=
# #scene-requests — "On Hold" completion tag (archived after 1 week)
DISCORD_TAG_ON_HOLD=

# #feature-requests — status tags removed when marked as Shipped
DISCORD_TAG_NEW_FEATURE_REQUESTS=
DISCORD_TAG_PLANNED_FEATURE_REQUESTS=
# #feature-requests — "Not Planned" completion tag (archived after 1 week)
DISCORD_TAG_NOT_PLANNED=

# ------------------------------------------
# Per-game roles (OPTIONAL — the only optional vars here)
# ------------------------------------------
# One per game, named after its `game_id`: DISCORD_GAME_ROLE_<GAMEID>.
# role_sync grants these ADDITIVELY to each admin of that game and NEVER removes
# one — Discord onboarding hands the same roles to members who self-select a
# game, and a reverse pass would strip those from hundreds of players.
#
# Unset means that game's role simply is not synced, which is the correct state
# while the roles are rolling out. The bot logs which games are syncing and which
# have no role at boot, so an unset var is visible rather than inferred.
#
# Adding game #3 is one more line here — no code change.
#
# Staging a role AHEAD of the game is supported and expected: the roles below
# exist in Discord for games DigiLab has not launched, and naruto has no row in
# the `games` table at all. Nothing is granted for those until the game has a row
# and active scenes, at which point it starts on its own.
#
# The catch, and the reason the boot check reports four separate states: a role
# staged for an unlaunched game and a MISTYPED game id behave identically —
# both parse, both are valid snowflakes, both grant nothing, forever, silently.
# The suffix must match `games.game_id` exactly (ONEPIECE, not ONE_PIECE). The
# startup log tells you which bucket each one landed in.
DISCORD_GAME_ROLE_DIGIMON=
DISCORD_GAME_ROLE_GUNDAM=
DISCORD_GAME_ROLE_ONEPIECE=
DISCORD_GAME_ROLE_FUSIONWORLD=
DISCORD_GAME_ROLE_UNIONARENA=
DISCORD_GAME_ROLE_NARUTO=

# ------------------------------------------
# Discord Webhook URLs
# ------------------------------------------
# Server Settings → Integrations → Webhooks → Copy Webhook URL
DISCORD_WEBHOOK_BOT_LOG=
# #admin-digest — weekly scene-health digest destination (the web app's daily
# request digest posts to the same channel via its own webhook env)
DISCORD_WEBHOOK_ADMIN_DIGEST=

# ------------------------------------------
# Neon PostgreSQL (same instance as digilab-app)
# ------------------------------------------
NEON_HOST=
NEON_DATABASE=
NEON_USER=
NEON_PASSWORD=
